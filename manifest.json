{
  "manifestVersion": 2,
  "id": "hanako-mail",
  "name": "Hanako Mail",
  "version": "0.6.18",
  "description": "多邮箱聚合：IMAP/SMTP、ClawEmail，AI 总结与实时通知。",
  "minAppVersion": "0.946.2",
  "entry": "index.js",
  "icon": "assets/icon-v11.png",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/process.spawn",
    "app/runtime.execute",
    "app/runtime.native",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/models.infer",
    "app/models.read",
    "app/provider.credentials.read",
    "app/ui.open-external",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "cards": [
      {
        "id": "mail-page",
        "title": "邮件",
        "description": "多邮箱聚合管理：IMAP/SMTP + 官方 API",
        "route": "/mail.html",
        "cardForm": "flush",
        "realization": "page",
        "siteNavEntry": false,
        "detached": { "route": "/mail.html" },
        "detachedDefaultSize": { "width": 1200, "height": 800 },
        "face": { "image": "face-v4.png" }
      }
    ]
  }
}
